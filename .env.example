# Which LLM writes new questions: gemini (free tier) or claude
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional, only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_CHECK_MODEL=claude-haiku-5-5
# Where the database and imported material live (gitignored)
SAT_DATA_DIR=data/private
